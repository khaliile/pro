{
  "name": "study-quest",
  "version": "1.0.0",
  "private": true,
  "description": "A cozy, offline study companion for 3APIC.",
  "author": "Study Quest",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run clean:lock && concurrently --kill-others -n vite,electron \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron . --no-sandbox",
    "clean:lock": "node -e \"const os=require('os'),path=require('path'),fs=require('fs');const d=path.join(os.homedir(),'.config','study-quest');['SingletonLock','SingletonCookie','SingletonSocket'].forEach(f=>{try{fs.unlinkSync(path.join(d,f))}catch{}})\"",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:deb": "npm run build && electron-builder --linux deb"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.studyquest.desktop",
    "productName": "Study Quest",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Education",
      "maintainer": "Study Quest",
      "synopsis": "Your calm, offline study companion",
      "artifactName": "Study-Quest-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Keywords": "Study;Education;3APIC;Homework;",
          "StartupWMClass": "study-quest"
        }
      }
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0"]
    }
  }
}
